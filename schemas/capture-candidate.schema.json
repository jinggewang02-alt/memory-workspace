{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/capture-candidate.schema.json",
  "title": "Adaptive capture candidate",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"},
    {"$ref": "#/$defs/v3"}
  ],
  "$defs": {
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "fingerprint", "trigger_event_id", "episode_id", "evidence_event_ids", "scope", "kind", "content", "confidence", "sensitivity", "proposed_at", "proposed_by", "policy_version", "policy_rule", "trigger_phase", "target_hint"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_id": {"type": "string", "pattern": "^cand_[A-Za-z0-9_-]+$"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "trigger_event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$"},
        "episode_id": {"type": ["string", "null"]},
        "evidence_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$"}},
        "scope": {"enum": ["project", "profile"]},
        "kind": {"enum": ["fact", "preference", "decision", "learning"]},
        "content": {"type": "string", "minLength": 1},
        "confidence": {"type": "number"},
        "sensitivity": {"enum": ["normal", "sensitive"]},
        "proposed_at": {"type": "string", "format": "date-time"},
        "proposed_by": {"type": "string", "minLength": 1},
        "policy_version": {"type": ["string", "null"]},
        "policy_rule": {"type": ["string", "null"]},
        "trigger_phase": {"type": ["string", "null"]},
        "target_hint": {"$ref": "#/$defs/target_hint"}
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "fingerprint", "trigger_event_id", "episode_id", "evidence_event_ids", "scope", "kind", "content", "confidence", "sensitivity", "proposed_at", "proposed_by", "policy_version", "policy_rule", "trigger_phase", "target_hint", "project_id", "claim_type", "subject_refs", "evidence_refs", "temporal_scope", "novelty_score", "reason_codes", "proposed_patch"],
      "properties": {
        "schema_version": {"const": 2},
        "candidate_id": {"type": "string", "pattern": "^cand_[A-Za-z0-9_-]+$"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "trigger_event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$"},
        "episode_id": {"type": ["string", "null"]},
        "evidence_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$"}},
        "scope": {"enum": ["project", "profile"]},
        "kind": {"enum": ["fact", "preference", "decision", "learning", "project_context", "entity_relation", "action_item", "artifact", "project_status"]},
        "content": {"type": "string", "minLength": 1},
        "confidence": {"type": "number"},
        "sensitivity": {"enum": ["normal", "sensitive"]},
        "proposed_at": {"type": "string", "format": "date-time"},
        "proposed_by": {"type": "string", "minLength": 1},
        "policy_version": {"type": ["string", "null"]},
        "policy_rule": {"type": ["string", "null"]},
        "trigger_phase": {"type": ["string", "null"]},
        "target_hint": {"$ref": "#/$defs/target_hint"},
        "project_id": {"type": ["string", "null"]},
        "claim_type": {"enum": ["project_context", "entity_relation", "decision", "action_item", "artifact", "project_status", "profile_fact"]},
        "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "temporal_scope": {"$ref": "#/$defs/temporal_scope"},
        "novelty_score": {"type": "number"},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "proposed_patch": {"$ref": "#/$defs/proposed_patch"}
      }
    },
    "v3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "fingerprint", "trigger_event_id", "episode_id", "evidence_event_ids", "scope", "kind", "content", "confidence", "sensitivity", "proposed_at", "proposed_by", "policy_version", "policy_rule", "trigger_phase", "target_hint", "project_id", "claim_type", "subject_refs", "evidence_refs", "temporal_scope", "novelty_score", "reason_codes", "proposed_patch"],
      "properties": {
        "schema_version": {"const": 3},
        "candidate_id": {"type": "string", "pattern": "^cand_[A-Za-z0-9_-]+$"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "trigger_event_id": {"type": ["string", "null"], "pattern": "^evt_[A-Za-z0-9_-]+$"},
        "episode_id": {"type": ["string", "null"]},
        "evidence_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$"}},
        "scope": {"enum": ["personal", "workspace"]},
        "kind": {"enum": ["exact_profile", "work_context", "relationship", "preference", "habit", "decision", "learning", "project_context", "action_item", "artifact", "project_status"]},
        "content": {"type": "string", "minLength": 1},
        "confidence": {"type": "number"},
        "sensitivity": {"enum": ["normal", "sensitive"]},
        "proposed_at": {"type": "string", "format": "date-time"},
        "proposed_by": {"type": "string", "minLength": 1},
        "policy_version": {"type": ["string", "null"]},
        "policy_rule": {"type": ["string", "null"]},
        "trigger_phase": {"type": ["string", "null"]},
        "target_hint": {"$ref": "#/$defs/target_hint_v3"},
        "project_id": {"type": ["string", "null"]},
        "claim_type": {"enum": ["exact_profile_fact", "work_context", "responsibility", "relationship", "preference", "habit", "project_context", "decision", "action_item", "artifact", "project_status"]},
        "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "temporal_scope": {"$ref": "#/$defs/temporal_scope"},
        "novelty_score": {"type": "number"},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "proposed_patch": {"$ref": "#/$defs/proposed_patch"}
      }
    },
    "target_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "profile_key"],
      "properties": {
        "workspace_id": {"type": ["string", "null"]},
        "profile_key": {"type": ["string", "null"]}
      }
    },
    "target_hint_v3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "personal_section", "exact_key"],
      "properties": {
        "workspace_id": {"type": ["string", "null"]},
        "personal_section": {"enum": [null, "exact_profile", "work", "relationships", "preferences", "learning"]},
        "exact_key": {"type": ["string", "null"]}
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref", "snapshot_ref"],
      "properties": {
        "ref_type": {"enum": ["capture_event", "external_observation", "source_note"]},
        "ref": {"type": "string", "minLength": 1},
        "snapshot_ref": {"type": ["string", "null"]}
      }
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": ["string", "null"], "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "proposed_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target_path", "summary"],
      "properties": {
        "operation": {"enum": ["create", "update", "append", "none"]},
        "target_path": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
