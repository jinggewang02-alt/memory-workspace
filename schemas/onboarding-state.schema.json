{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/onboarding-state.schema.json",
  "title": "First-run history learning state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "started_at", "window", "source", "import_summary", "habits_report_id", "habits_markdown_path", "policy_id", "confirmed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^onboard_[A-Za-z0-9_-]+$"},
    "status": {"enum": ["awaiting_review", "completed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "days"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "days": {"type": "integer"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "source_path", "boundary"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "import_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_rows", "user_rows", "imported_count", "duplicate_count", "rejected_secret_count", "ignored_non_user_count", "outside_window_count"],
      "properties": {
        "input_rows": {"type": "integer"},
        "user_rows": {"type": "integer"},
        "imported_count": {"type": "integer"},
        "duplicate_count": {"type": "integer"},
        "rejected_secret_count": {"type": "integer"},
        "ignored_non_user_count": {"type": "integer"},
        "outside_window_count": {"type": "integer"}
      }
    },
    "habits_report_id": {"type": "string", "pattern": "^habits_[A-Za-z0-9_-]+$"},
    "habits_markdown_path": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "pattern": "^policy_[A-Za-z0-9_-]+$"},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
