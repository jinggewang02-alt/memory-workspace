{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/capture-application.schema.json",
  "title": "Capture candidate application receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "applied_at",
    "actor",
    "target_ref",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^cand_[A-Za-z0-9_-]+$"},
    "applied_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "verification": {"type": "string", "minLength": 1}
  }
}
