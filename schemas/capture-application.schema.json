{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/capture-application.schema.json",
  "title": "Capture candidate application receipt",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "applied_at", "actor", "target_ref", "verification"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_id": {"type": "string", "pattern": "^cand_[A-Za-z0-9_-]+$"},
        "applied_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1}
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "applied_at", "actor", "target_ref", "writer", "verification"],
      "properties": {
        "schema_version": {"const": 2},
        "candidate_id": {"type": "string", "pattern": "^cand_[A-Za-z0-9_-]+$"},
        "applied_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "writer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "operation_id"],
              "properties": {
                "kind": {"const": "profile_single"},
                "operation_id": {"const": null}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "operation_id"],
              "properties": {
                "kind": {"const": "workspace_operation"},
                "operation_id": {"type": "string", "pattern": "^op_[A-Za-z0-9_-]+$"}
              }
            }
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "checks"],
          "properties": {
            "status": {"const": "passed"},
            "summary": {"type": "string", "minLength": 1},
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
