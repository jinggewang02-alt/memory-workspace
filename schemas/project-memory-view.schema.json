{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/project-memory-view.schema.json",
  "title": "Rebuildable project memory read model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "generated_at", "status", "notice", "connectors", "sections", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
    },
    "generated_at": {"type": ["string", "null"]},
    "status": {"enum": ["empty", "ready"]},
    "notice": {"type": "string", "minLength": 1},
    "connectors": {"type": "array", "items": {"$ref": "#/$defs/connector"}},
    "sections": {
      "type": "object", "additionalProperties": false,
      "required": ["updates", "decisions", "next_actions", "people", "artifacts"],
      "properties": {
        "updates": {"$ref": "#/$defs/items"}, "decisions": {"$ref": "#/$defs/items"},
        "next_actions": {"$ref": "#/$defs/items"}, "people": {"$ref": "#/$defs/items"}, "artifacts": {"$ref": "#/$defs/items"}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "occurred_at", "classification", "source_id", "source_note", "snapshot_ref"],
      "properties": {
        "text": {"type": "string", "minLength": 1}, "occurred_at": {"type": ["string", "null"]},
        "classification": {"enum": ["source_excerpt", "explicit_marker", "observed_actor", "artifact_metadata"]},
        "source_id": {"type": "string", "minLength": 1}, "source_note": {"type": "string", "pattern": "^wiki/sources/S-[0-9]+\\.md$"},
        "snapshot_ref": {"type": "string", "pattern": "^connected/"}
      }
    },
    "connector": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "configured", "enabled", "mapped_sources", "last_success_at", "coverage_end"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "configured": {"type": "boolean"}, "enabled": {"type": "boolean"},
        "mapped_sources": {"type": "integer"}, "last_success_at": {"type": ["string", "null"]}, "coverage_end": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "provider", "kind", "label", "external_id", "source_note", "latest_snapshot_ref", "captured_at"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}, "external_id": {"type": "string", "minLength": 1},
        "source_note": {"type": "string", "pattern": "^wiki/sources/S-[0-9]+\\.md$"},
        "latest_snapshot_ref": {"type": "string", "pattern": "^connected/"}, "captured_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
