{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/workspace-index.schema.json",
  "title": "Memory Home derived index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "workspace",
    "projects",
    "sources",
    "pages",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "projects": {
      "type": "array",
      "items": {"$ref": "#/$defs/project"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page"}
    },
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "page_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "page_count": {"type": "integer"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "path",
        "content_path",
        "captured_at",
        "status",
        "content_hash"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_path": {"type": ["string", "null"]},
        "captured_at": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "content_hash": {"type": ["string", "null"]}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title", "kind", "source_refs", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "content": {"type": "string"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "type",
        "status",
        "requested_at",
        "actor",
        "changes_count"
      ],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "requested_at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "changes_count": {"type": "integer"}
      }
    }
  }
}
