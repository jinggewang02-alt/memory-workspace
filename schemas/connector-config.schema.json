{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-workspace.dev/schemas/connector-config.schema.json",
  "title": "Explicit domain connector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "provider",
    "workspace_id",
    "enabled",
    "identity_mode",
    "activation",
    "capabilities",
    "baseline",
    "schedule",
    "review",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "connector_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "enabled": {"type": "boolean"},
    "identity_mode": {"enum": ["user", "bot"]},
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit", "actor", "activated_at", "deactivated_at"],
      "properties": {
        "explicit": {"const": true},
        "actor": {"type": "string", "minLength": 1},
        "activated_at": {"type": "string", "format": "date-time"},
        "deactivated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "chat_metadata",
          "message_history",
          "drive_search",
          "drive_metadata",
          "event_acceleration"
        ]
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookback_days",
        "max_active_chats",
        "initial_messages_per_chat",
        "expanded_messages_per_chat"
      ],
      "properties": {
        "lookback_days": {"type": "integer"},
        "max_active_chats": {"type": "integer"},
        "initial_messages_per_chat": {"type": "integer"},
        "expanded_messages_per_chat": {"type": "integer"}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "minimum_interval_hours", "event_acceleration"],
      "properties": {
        "trigger": {"const": "agent_start_or_idle"},
        "minimum_interval_hours": {"type": "integer"},
        "event_acceleration": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_review_required", "profile_write_allowed"],
      "properties": {
        "candidate_review_required": {"const": true},
        "profile_write_allowed": {"const": false}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
